# SERVER-SIDE environment for the research worker (services/research-worker).
# Copy to .env in the repo root (git-ignored) on the machine that runs the worker.
# NEVER put any of these in apps/mobile/.env: they must not reach the mobile bundle.
# Use separate Supabase projects for development, staging and production.

# Supabase project URL and SERVICE-ROLE key (bypasses RLS: treat like a root password).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Who is fetching pages, sent in the User-Agent so site owners can reach you. Required.
# Example: research@yourdomain.in
RESEARCH_CONTACT=

# Search provider: "stub" (development: returns nothing) or "brave".
SEARCH_PROVIDER=stub
SEARCH_PROVIDER_API_KEY=

# Extraction model: "stub" (development: extracts nothing) or "anthropic".
# LLM_MODEL is required for a real provider; a small, inexpensive model is enough.
LLM_PROVIDER=stub
LLM_PROVIDER_API_KEY=
LLM_MODEL=

# Geocoder: "none" (a reviewer places every pin) or "nominatim".
# The public Nominatim instance allows 1 request per second and light use only.
# Point GEOCODER_BASE_URL at your own instance or a commercial host for volume.
GEOCODER=none
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_API_KEY=

# Limits. The worker processes a bounded batch and exits; schedule it (cron, GitHub Actions, etc.).
WORKER_ID=research-worker-1
MAX_PAGES_PER_JOB=4
MAX_JOBS_PER_RUN=5

# Local database tests only (npm run test:db). Not used in production.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
