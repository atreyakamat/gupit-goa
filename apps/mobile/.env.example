# Mobile app environment. Copy to apps/mobile/.env (git-ignored) and fill in.
#
# EVERYTHING HERE IS COMPILED INTO THE APP AND CAN BE READ BY ANYONE WHO INSTALLS IT.
# Only public, client-safe values belong in this file. Never put a service-role key,
# a secret key, or any search / AI / geocoder credential here. The app refuses to start
# if the Supabase key below looks like a privileged key.

# Supabase project URL, e.g. https://abcd1234.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (or "publishable") key. Safe to ship: Row Level Security is the gate.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre style JSON URL from a production tile provider (or your own tile server).
# A provider key embedded in this URL is a public, domain/app-restricted key by design.
# Do NOT point this at tile.openstreetmap.org. For a quick local look only, MapLibre's
# demo style works: https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_STYLE_URL=
